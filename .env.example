# Supabase Configuration
# 替换为你的实际 Supabase 项目配置
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 示例：
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_key_here

# Error reporting (optional). Without a DSN the setting is hidden and nothing
# is sent; with one, users still have to turn reports on in Settings.
# VITE_SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>

# Source map upload for release builds (optional, never commit the token).
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=momentum
# SENTRY_AUTH_TOKEN=sntrys_...
