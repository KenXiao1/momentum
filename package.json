{
  "name": "momentum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:md": "markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "lint:spell": "cspell --no-progress \"src/**/*.{ts,tsx}\"",
    "lint:spell:docs": "cspell --no-progress \"docs/**/*.md\" \"README*.md\" \"*.md\"",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:rust:check": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "quality:type-coverage": "type-coverage -p tsconfig.app.json --detail --strict --at-least 95",
    "quality:sonar:report": "node tools/quality/eslint-sonar-report.mjs",
    "quality:knip": "knip --config .knip.json",
    "quality:jscpd": "jscpd src --config .jscpd.json",
    "quality:css-structure": "node tools/quality/css-structure.mjs",
    "quality:i18n": "node tools/quality/i18n-budget.mjs",
    "quality:smell-audit": "node tools/quality/smell-audit.mjs",
    "quality:test:lint": "eslint -c eslint.tests.config.js \"src/**/*.{test,spec}.{js,ts,jsx,tsx}\" \"src/**/__tests__/**/*.{js,ts,jsx,tsx}\" --max-warnings 20",
    "quality:test:assertions": "node tools/quality/test-assertion-lint.mjs",
    "quality:test:coverage-hotspots": "node tools/quality/coverage-hotspots.mjs",
    "quality:test:runtime": "node tools/quality/test-runtime-budget.mjs --refresh",
    "quality:test:mutation-hotspots": "node tools/quality/mutation-hotspots.mjs",
    "quality:test:mutation-hotspots:required": "node tools/quality/mutation-hotspots.mjs --mode nightly --required",
    "quality:test:mutation-scope": "node tools/quality/mutation-scope-gate.mjs",
    "quality:test:audit": "npm run quality:test:lint && npm run quality:test:assertions && npm run quality:test:mutation-scope && npm run quality:test:runtime && npm run test:coverage && npm run quality:test:coverage-hotspots && npm run quality:test:mutation-hotspots",
    "quality:arch-gate": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "quality:rust": "npm run format:rust:check && npm run lint:rust && npm run test:rust",
    "quality:ci:required": "npm run format:check && npm run lint && npm run lint:css && npm run quality:css-structure && npm run lint:md && npm run lint:spell && npm run lint:spell:docs && npm run typecheck && npm run quality:i18n && npm run quality:type-coverage && npm run quality:knip && npm run quality:arch-gate && npm run quality:test:lint && npm run quality:test:assertions && npm run test:coverage && npm run quality:test:coverage-hotspots && npm run quality:rust && npm run build",
    "quality:ci:info": "node tools/quality/lane-runner.mjs info",
    "quality:ci:nightly": "node tools/quality/lane-runner.mjs nightly",
    "security:semgrep": "node tools/quality/run-ps.mjs tools/quality/semgrep.ps1",
    "security:npm-audit": "npm audit --audit-level=high",
    "quality:licenses": "license-checker --summary",
    "lint:sql": "node tools/quality/run-ps.mjs tools/quality/sqlfluff.ps1",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "node tools/quality/run-test-coverage.mjs",
    "test:all": "vitest run --config vitest.config.ts",
    "test:all:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --features desktop",
    "test:mutation": "npm run quality:test:mutation-scope && node tools/quality/run-mutation.mjs --mode nightly",
    "test:mutation:critical": "npm run quality:test:mutation-scope && node tools/quality/run-mutation.mjs --mode critical && node tools/quality/mutation-hotspots.mjs --mode critical --required",
    "tauri": "tauri"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-haptics": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "cspell": "^9.6.3",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-sonarjs": "^3.0.6",
    "eslint-plugin-testing-library": "^7.15.4",
    "globals": "^15.15.0",
    "jscpd": "^4.0.8",
    "jsdom": "^24.1.3",
    "knip": "^5.83.0",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.20.0",
    "msw": "^2.12.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "stylelint": "^17.1.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17"
  }
}
